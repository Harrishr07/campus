 "html": "<div style=\"width:340px;border:2px solid #234;border-radius:8px;padding:10px;font-family:sans-serif;font-size:12px\">\n\t<div style=\"text-align:center;font-weight:bold;font-size:14px\">{{ doc.oc_company | e }}</div>\n\t<div style=\"text-align:center;letter-spacing:1px;margin-bottom:6px\">{{ _(\"STUDENT ID CARD\") }}</div>\n\t{% set enrollment = frappe.db.get_value(\"Program Enrollment\", {\"student\": doc.name, \"docstatus\": 1}, [\"program\", \"academic_year\"], as_dict=True, order_by=\"creation desc\") %}\n\t<table style=\"width:100%\"><tr>\n\t\t<td style=\"width:100px;vertical-align:top\">\n\t\t\t{% if doc.image %}<img class=\"oc-student-photo\" src=\"{{ doc.image | e }}\" style=\"width:90px;height:110px;object-fit:cover\">{% else %}<div style=\"width:90px;height:110px;border:1px solid #999\"></div>{% endif %}\n\t\t</td>\n\t\t<td style=\"vertical-align:top\">\n\t\t\t<div style=\"font-size:15px;font-weight:bold\">{{ doc.student_name | e }}</div>\n\t\t\t<div>{{ _(\"Register No\") }}: <b>{{ (doc.oc_register_no or \"\") | e }}</b></div>\n\t\t\t<div>{{ _(\"Program\") }}: {{ enrollment.program if enrollment else \"\" }}</div>\n\t\t\t<div>{{ _(\"Batch\") }}: {{ doc.oc_batch or (enrollment.academic_year if enrollment else \"\") }}</div>\n\t\t\t<div>{{ _(\"Blood Group\") }}: {{ (doc.blood_group or \"\") | e }}</div>\n\t\t</td>\n\t</tr></table>\n\t<div style=\"text-align:center;margin-top:6px\">{{ oc_qr_block(doc) }}</div>\n</div>\n",
